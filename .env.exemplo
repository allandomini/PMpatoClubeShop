# ==========================================================
# KubeShop - Variáveis da execução local (Docker Compose)
#
# Copie para ".env" e troque as senhas, ou rode:
#   node roteiros/setup.mjs
# que gera o .env com senhas aleatórias automaticamente.
#
# O arquivo .env está no .gitignore e NUNCA deve ser versionado.
# ==========================================================

# Versão exibida em /api/info e usada na tag das imagens.
APP_VERSION=1.0.0

# Endereço e porta em que a loja fica acessível.
# 127.0.0.1 = só nesta máquina; 0.0.0.0 = toda a rede local.
KUBESHOP_BIND=127.0.0.1
KUBESHOP_PORT=8080

# Banco da aplicação.
MONGO_DATABASE=kubeshop

# Administrador do MongoDB (usado só na criação do banco e em backups).
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=troque-esta-senha-root

# Usuário da API (permissão apenas de leitura/escrita no banco kubeshop).
MONGO_APP_USERNAME=kubeshop
MONGO_APP_PASSWORD=troque-esta-senha-app
